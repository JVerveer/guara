    else false
  end as has_total_category,
  'generated'::text as metadata_origin,
  now() as generated_at
from "postgres"."semantic_dbt_staging"."stg_gold_bouwen_wonen_categories"
group by dataset_key, dataset_code, dimension_code
  );
  
